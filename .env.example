# ⚠ 더 이상 쓰지 않습니다. 모든 설정은 settings.yaml(견본: settings.example.yaml)로 옮겨졌습니다.
#   .env가 남아 있으면 앱을 처음 실행할 때 그 값이 settings.yaml로 한 번 옮겨집니다.

# AI 설정 (둘 중 하나만 있으면 됨)
AI_PROVIDER=openrouter

# OpenRouter (무료 모델 사용 가능 - https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Anthropic (유료 - https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# YouTube Data API (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

# 크롬 프로필 경로 (필수: 유튜브1, 선택: 유튜브2, 유튜브3)
# chrome://version 에서 프로필 경로 확인
CHROME_PROFILE_1=C:/Users/사용자/AppData/Local/Google/Chrome/User Data/Profile 1
CHROME_PROFILE_2=
CHROME_PROFILE_3=

# 운영 설정
DAILY_MAX_COMMENTS=10
COMMENT_MIN_CHARS=40
COMMENT_MAX_CHARS=120
BRAND_NAME=운명원
